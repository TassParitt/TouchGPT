{
  "name": "touchgpt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build && node scripts/build-sw.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}
