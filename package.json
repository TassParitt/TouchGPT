{
  "name": "touchgpt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build && node scripts/build-sw.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare-build",
    "test:cloudflare": "npm run check:cloudflare && node --test tests/cloudflare.test.mjs",
    "check:pages": "wrangler pages functions build --outdir .cloudflare-build/pages --compatibility-date 2026-01-01 --compatibility-flags nodejs_compat"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^4.4.0",
    "miniflare": "^5.20261019.0-beta",
    "prettier": "^3.9.10",
    "vite": "^6.4.0",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=24"
  }
}
